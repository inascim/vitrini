---
import { Image } from 'astro:assets';
import { config } from '../lib/config';
import { resolveImage } from '../lib/assets';
import { whatsappHref } from '../lib/url';
import { emphasis } from '../lib/format';
import type { Translate } from '../lib/i18n';

interface Props {
  hero: { role: string; headline: string; intro?: string; availability?: string };
  t: Translate;
}

const { hero, t } = Astro.props;
const avatar = config.avatar ? resolveImage(config.avatar) : undefined;
const { email, whatsapp } = config.contact;
---

<section class="hero container" id="top">
  <div class="hero-meta reveal">
    {avatar && <Image src={avatar} alt="" width={96} height={96} class="hero-avatar" loading="eager" />}
    <div>
      <p class="hero-name">{config.name}</p>
      <p class="hero-role">{hero.role}{config.location && <span> · {config.location}</span>}</p>
    </div>
  </div>
  <h1 class="hero-headline reveal" set:html={emphasis(hero.headline)} />
  {hero.intro && <p class="hero-intro reveal">{hero.intro}</p>}
  <div class="hero-actions reveal">
    {hero.availability && <span class="badge"><span class="dot" aria-hidden="true"></span>{hero.availability}</span>}
    {whatsapp && <a class="btn btn-primary" href={whatsappHref(whatsapp)} rel="noopener" target="_blank">{t('contact.whatsapp')}</a>}
    {email && <a class="btn btn-ghost" href={`mailto:${email}`}>{t('contact.email')}</a>}
  </div>
</section>
