---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { config } from '../lib/config';
import { getAbout } from '../lib/content';
import { resolveImage } from '../lib/assets';
import type { Translate } from '../lib/i18n';
import SectionHeading from './SectionHeading.astro';

interface Props {
  locale: string;
  t: Translate;
  text?: { title?: string; intro?: string };
}

const { locale, t, text } = Astro.props;
const about = await getAbout(locale);
const { Content } = await render(about.entry);
const photo = config.avatar ? resolveImage(config.avatar) : undefined;
---

<section class="section container" id="about">
  <SectionHeading title={text?.title ?? t('section.about')} intro={text?.intro} />
  <div class="about-grid">
    {photo && <Image src={photo} alt={config.name} widths={[400, 800]} sizes="(min-width: 900px) 33vw, 100vw" class="about-photo reveal" />}
    <div class="prose reveal" lang={about.locale}>
      <Content />
    </div>
  </div>
</section>
