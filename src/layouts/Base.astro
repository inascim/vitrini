---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { config } from '../lib/config';
import { presets, contrastText, fontsUrl } from '../lib/themes';
import { localeHref, href } from '../lib/url';
import type { Translate } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';

interface Props {
  locale: string;
  t: Translate;
  title: string;
  description: string;
  /** Locale-independent path of this page, e.g. "" or "cases/my-case". */
  path: string;
  image?: ImageMetadata;
}

const { locale, t, title, description, path, image } = Astro.props;

const preset = presets[config.theme.preset];
const accent = config.theme.accent || preset.accent;
const heading = config.theme.fonts.heading ? { family: config.theme.fonts.heading } : preset.heading;
const body = config.theme.fonts.body ? { family: config.theme.fonts.body } : preset.body;

const palette = (p: typeof preset.light) =>
  `--bg:${p.bg};--surface:${p.surface};--fg:${p.fg};--muted:${p.muted};--line:${p.line};`;
const themeCss = `
:root{--accent:${accent};--accent-fg:${contrastText(accent)};--font-heading:'${heading.family}',Georgia,serif;--font-body:'${body.family}',system-ui,sans-serif;--heading-weight:${preset.headingWeight};--heading-tracking:${preset.headingTracking};${palette(preset.light)}}
[data-mode=dark]{${palette(preset.dark)}color-scheme:dark}
@media (prefers-color-scheme:dark){[data-mode=system]{${palette(preset.dark)}color-scheme:dark}}
`;

const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ogImage = image ? absolute((await getImage({ src: image, width: 1200, format: 'jpg' })).src) : undefined;
const canonical = absolute(localeHref(locale, path));
---

<!doctype html>
<html lang={locale} data-mode={config.theme.mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {config.locales.map((l) => <link rel="alternate" hreflang={l} href={absolute(localeHref(l, path))} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(localeHref(config.defaultLocale, path))} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl(heading, body)} />
    <style is:inline set:html={themeCss}></style>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <Header locale={locale} t={t} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer t={t} />
    <Consent t={t} />
    <script>
      // Reveal-on-scroll. Elements stay visible if JS is off or motion is reduced.
      const items = document.querySelectorAll('.reveal');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
